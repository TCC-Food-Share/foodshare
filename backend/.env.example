DATABASE_URL="postgresql://usuario:senha@localhost:5433/foodshare?schema=public"

MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="troque-me"
MINIO_SECRET_KEY="troque-me"

JWT_SECRET="gere-com-openssl-rand-base64-32"

# URL pública desta API. Dev: http://localhost:3000. Staging: https://api.staging.foodshare.com.br
BETTER_AUTH_URL="http://localhost:3000"

# Origens confiáveis do frontend — usadas pelo originCheck do better-auth
# (login/logout são POST) e pelo CORS. Lista separada por vírgula.
# Dev: a origem do Vite. Staging: https://app.staging.foodshare.com.br
# Default (quando omitido): http://localhost:5173
TRUSTED_ORIGINS="http://localhost:5173"

# Domínio do site pai para o cookie de sessão, quando front e API estão em
# subdomínios distintos (staging/prod). Deixe VAZIO em dev (cookie host-only,
# SameSite=Lax, mesma origem via proxy do Vite).
# Staging: .staging.foodshare.com.br   (o ponto inicial é intencional)
COOKIE_DOMAIN=""
