generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Papel {
  id       Int       @id @default(autoincrement())
  nome     String    @unique @db.VarChar(50)
  usuarios Usuario[]

  @@map("papel")
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nome           String   @db.VarChar(200)
  email          String   @unique @db.VarChar(200)
  celularPessoal String   @unique @db.VarChar(20)
  senha          String   @db.VarChar(255)
  imagem         String?  @db.VarChar(500)
  dataCadastro   DateTime @default(now())
  deletado       Boolean  @default(false)
  authUserId     String?  @unique

  idPapel Int
  papel   Papel @relation(fields: [idPapel], references: [id])

  estabelecimento      Estabelecimento?
  entidadeBeneficiaria EntidadeBeneficiaria?
  motivosCancelamento  MotivoCancelamento[]  @relation("AdministradorMotivo")

  @@map("usuario")
}

model Endereco {
  id          Int     @id @default(autoincrement())
  cep         String  @db.VarChar(9)
  logradouro  String  @db.VarChar(300)
  numero      String  @db.VarChar(10)
  complemento String? @db.VarChar(200)
  cidade      String  @db.VarChar(200)
  estado      String  @db.VarChar(2)

  estabelecimento      Estabelecimento?
  entidadeBeneficiaria EntidadeBeneficiaria?

  @@map("endereco")
}

model Estabelecimento {
  id                   Int     @id @default(autoincrement())
  razaoSocial          String  @db.VarChar(300)
  nomeFantasia         String? @db.VarChar(200)
  cnpj                 String  @unique @db.VarChar(18)
  emailInstitucional   String  @unique @db.VarChar(200)
  celularInstitucional String  @unique @db.VarChar(20)
  descricao            String  @db.VarChar(2000)
  deletado             Boolean @default(false)

  idUsuario Int     @unique
  usuario   Usuario @relation(fields: [idUsuario], references: [id])

  idEndereco Int      @unique
  endereco   Endereco @relation(fields: [idEndereco], references: [id])

  alimentos Alimento[]
  pedidos   Pedido[]

  @@map("estabelecimento")
}

model EntidadeBeneficiaria {
  id                   Int     @id @default(autoincrement())
  razaoSocial          String  @db.VarChar(300)
  nomeFantasia         String? @db.VarChar(200)
  cnpj                 String  @unique @db.VarChar(18)
  emailInstitucional   String  @unique @db.VarChar(200)
  celularInstitucional String  @unique @db.VarChar(20)
  descricao            String  @db.VarChar(2000)
  deletado             Boolean @default(false)

  idUsuario Int     @unique
  usuario   Usuario @relation(fields: [idUsuario], references: [id])

  idEndereco Int      @unique
  endereco   Endereco @relation(fields: [idEndereco], references: [id])

  pedidos Pedido[]

  @@map("entidade_beneficiaria")
}

model Categoria {
  id        Int        @id @default(autoincrement())
  nome      String     @unique @db.VarChar(100)
  alimentos Alimento[]

  @@map("categoria")
}

model StatusAlimento {
  id        Int        @id @default(autoincrement())
  nome      String     @unique @db.VarChar(50)
  alimentos Alimento[]

  @@map("status_alimento")
}

model StatusPedido {
  id      Int      @id @default(autoincrement())
  nome    String   @unique @db.VarChar(50)
  pedidos Pedido[]

  @@map("status_pedido")
}

model Alimento {
  id             Int      @id @default(autoincrement())
  imagem         String?  @db.VarChar(500)
  nome           String   @db.VarChar(200)
  qtdUnidade     String   @db.VarChar(50)
  descricao      String   @db.VarChar(2000)
  estado         String?  @db.VarChar(50)
  dataVencimento DateTime
  dataPublicacao DateTime
  deletado       Boolean  @default(false)

  idCategoria Int
  categoria   Categoria @relation(fields: [idCategoria], references: [id])

  idEstabelecimento Int
  estabelecimento   Estabelecimento @relation(fields: [idEstabelecimento], references: [id])

  idStatus Int
  status   StatusAlimento @relation(fields: [idStatus], references: [id])

  pedidos Pedido[]

  @@map("alimento")
}

model MotivoCancelamento {
  id   Int    @id @default(autoincrement())
  nome String @unique @db.VarChar(200)

  idAdministrador Int
  administrador   Usuario @relation("AdministradorMotivo", fields: [idAdministrador], references: [id])

  pedidos Pedido[]

  @@map("motivo_cancelamento")
}

model Pedido {
  id         Int      @id @default(autoincrement())
  dataPedido DateTime @default(now())
  quantidade Int
  deletado   Boolean  @default(false)

  idAlimento Int
  alimento   Alimento @relation(fields: [idAlimento], references: [id])

  idStatus Int
  status   StatusPedido @relation(fields: [idStatus], references: [id])

  idEstabelecimento Int
  estabelecimento   Estabelecimento @relation(fields: [idEstabelecimento], references: [id])

  idEntidadeBeneficiaria Int
  entidadeBeneficiaria   EntidadeBeneficiaria @relation(fields: [idEntidadeBeneficiaria], references: [id])

  idMotivoCancelamento Int?
  motivoCancelamento   MotivoCancelamento? @relation(fields: [idMotivoCancelamento], references: [id])

  @@map("pedido")
}
