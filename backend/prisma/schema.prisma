generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("role")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(200)
  email         String   @unique @db.VarChar(200)
  emailVerified Boolean  @default(true)
  personalPhone String?  @unique @db.VarChar(20)
  image         String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deleted       Boolean  @default(false)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  establishment       Establishment?
  beneficiaryEntity   BeneficiaryEntity?
  cancellationReasons CancellationReason[] @relation("AdministratorReason")
  categories          Category[]           @relation("CategoryAdministrator")
  catalogItems        FoodCatalogItem[]    @relation("CatalogItemAdministrator")
  measurementUnits    MeasurementUnit[]    @relation("MeasurementUnitAdministrator")
  prohibitedTerms     ProhibitedTerm[]     @relation("ProhibitedTermAdministrator")
  suggestions         Suggestion[]         @relation("SuggestionRequester")
  reviewedSuggestions Suggestion[]         @relation("SuggestionReviewer")
  auditLogs           AuditLog[]
  accessLogs          AccessLog[]

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Address {
  id         Int      @id @default(autoincrement())
  postalCode String   @db.VarChar(9)
  street     String   @db.VarChar(300)
  number     String   @db.VarChar(10)
  complement String?  @db.VarChar(200)
  city       String   @db.VarChar(200)
  state      String   @db.VarChar(2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  establishment     Establishment?
  beneficiaryEntity BeneficiaryEntity?

  @@map("address")
}

model Establishment {
  id                 Int      @id @default(autoincrement())
  companyName        String   @db.VarChar(300)
  tradeName          String?  @db.VarChar(200)
  cnpj               String   @unique @db.VarChar(18)
  institutionalEmail String   @unique @db.VarChar(200)
  institutionalPhone String   @unique @db.VarChar(20)
  description        String   @db.VarChar(2000)
  deleted            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  addressId Int     @unique
  address   Address @relation(fields: [addressId], references: [id])

  foods  Food[]
  orders Order[]

  @@map("establishment")
}

model BeneficiaryEntity {
  id                 Int      @id @default(autoincrement())
  companyName        String   @db.VarChar(300)
  tradeName          String?  @db.VarChar(200)
  cnpj               String   @unique @db.VarChar(18)
  institutionalEmail String   @unique @db.VarChar(200)
  institutionalPhone String   @unique @db.VarChar(20)
  description        String   @db.VarChar(2000)
  deleted            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  addressId Int     @unique
  address   Address @relation(fields: [addressId], references: [id])

  orders Order[]

  @@map("beneficiary_entity")
}

model Category {
  id           Int               @id @default(autoincrement())
  name         String            @unique @db.VarChar(100)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  catalogItems FoodCatalogItem[]

  administratorId Int?
  administrator   User? @relation("CategoryAdministrator", fields: [administratorId], references: [id], onDelete: SetNull)

  @@map("category")
}

model FoodStatus {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  foods     Food[]

  @@map("food_status")
}

model OrderStatus {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@map("order_status")
}

model Food {
  id             Int             @id @default(autoincrement())
  image          String          @db.VarChar(500)
  quantity       Decimal         @db.Decimal(10, 2)
  requestType    FoodRequestType
  description    String          @db.VarChar(2000)
  notes          String?         @db.VarChar(2000)
  expirationDate DateTime
  publishedAt    DateTime
  deleted        Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  catalogItemId Int
  catalogItem   FoodCatalogItem @relation(fields: [catalogItemId], references: [id])

  measurementUnitId Int
  measurementUnit   MeasurementUnit @relation(fields: [measurementUnitId], references: [id])

  establishmentId Int
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  statusId Int
  status   FoodStatus @relation(fields: [statusId], references: [id])

  orders Order[]

  @@index([statusId, deleted])
  @@index([establishmentId, statusId])
  @@map("food")
}

enum FoodRequestType {
  TOTAL_ONLY
  PARTIAL_ONLY
  TOTAL_OR_PARTIAL
}

model CancellationReason {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(200)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  administratorId Int?
  administrator   User? @relation("AdministratorReason", fields: [administratorId], references: [id], onDelete: SetNull)

  orders Order[]

  @@map("cancellation_reason")
}

model Order {
  id        Int      @id @default(autoincrement())
  orderDate DateTime @default(now())
  quantity  Decimal  @db.Decimal(10, 2)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  foodId Int
  food   Food @relation(fields: [foodId], references: [id])

  statusId Int
  status   OrderStatus @relation(fields: [statusId], references: [id])

  establishmentId Int
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  beneficiaryEntityId Int
  beneficiaryEntity   BeneficiaryEntity @relation(fields: [beneficiaryEntityId], references: [id])

  cancellationReasonId Int?
  cancellationReason   CancellationReason? @relation(fields: [cancellationReasonId], references: [id])

  @@map("order")
}

model FoodCatalogItem {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  foods Food[]

  administratorId Int?
  administrator   User? @relation("CatalogItemAdministrator", fields: [administratorId], references: [id], onDelete: SetNull)

  @@map("food_catalog_item")
}

model MeasurementUnit {
  id             Int      @id @default(autoincrement())
  name           String   @unique @db.VarChar(50)
  abbreviation   String   @unique @db.VarChar(10)
  allowsFraction Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  foods          Food[]

  administratorId Int?
  administrator   User? @relation("MeasurementUnitAdministrator", fields: [administratorId], references: [id], onDelete: SetNull)

  @@map("measurement_unit")
}

model ProhibitedTerm {
  id        Int      @id @default(autoincrement())
  term      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  administratorId Int?
  administrator   User? @relation("ProhibitedTermAdministrator", fields: [administratorId], references: [id], onDelete: SetNull)

  @@map("prohibited_term")
}

enum SuggestionType {
  CATEGORY
  FOOD_CATALOG_ITEM
  MEASUREMENT_UNIT
  CANCELLATION_REASON
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Suggestion {
  id         Int              @id @default(autoincrement())
  type       SuggestionType
  text       String           @db.VarChar(200)
  status     SuggestionStatus @default(PENDING)
  reviewedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  requesterId Int
  requester   User @relation("SuggestionRequester", fields: [requesterId], references: [id])

  reviewerId Int?
  reviewer   User? @relation("SuggestionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, type])
  @@map("suggestion")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   @db.VarChar(50)
  entityType String   @db.VarChar(50)
  entityId   String   @db.VarChar(50)
  details    Json?
  createdAt  DateTime @default(now())

  administratorId Int?
  administrator   User? @relation(fields: [administratorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model AccessLog {
  id         Int      @id @default(autoincrement())
  method     String   @db.VarChar(10)
  path       String   @db.VarChar(500)
  statusCode Int
  durationMs Int
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@map("access_log")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
